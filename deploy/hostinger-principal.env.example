# Preparação do domínio principal; não substitui as variáveis privadas existentes.
NEXT_PUBLIC_SITE_URL=https://liga3colinas.com.br
L3C_API_URL=https://api-stats.liga3colinas.com.br/api
L3C_HOME_MODE=pre2027
L3C_PUBLIC_INDEXING=true
# Mudar para true somente depois de validar o domínio principal.
L3C_REDIRECT_OLD_DOMAIN=false
# O WordPress ainda atende automações. Este bloqueio evita concluir a configuração sem preservá-lo.
L3C_REQUIRE_LEGACY_WORDPRESS=true
# Preencher somente após criar e validar a instalação legada na Hostinger:
# L3C_LEGACY_WORDPRESS_ORIGIN=https://legado.liga3colinas.com.br
